# Production settings for docker-compose.prod.yml. Copy to .env.production (git-ignored) and fill in.
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Fernet key:             python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

APP_HOST=control.example.com
SITE_HOST=www.example.com

POSTGRES_USER=ccd
POSTGRES_DB=ccd
POSTGRES_PASSWORD=

SECRET_KEY=
INTERNAL_SERVICE_API_KEY=
CAMERA_CREDENTIAL_ENCRYPTION_KEY=

FIRST_ADMIN_EMAIL=
FIRST_ADMIN_PASSWORD=
FIRST_ADMIN_NAME=Platform Administrator

# Optional: require a bearer token on /metrics (also add it to infra/monitoring/prometheus.yml).
METRICS_TOKEN=
GRAFANA_ADMIN_PASSWORD=

# Demo data stays off in production unless you want the simulated station.
SEED_DEMO_DATA=false
SEED_DEMO_HISTORY=false

AI_SERVICE_DEVICE=auto

NOTIFICATION_EMAIL_PROVIDER=smtp
NOTIFICATION_SMS_PROVIDER=noop
NOTIFICATION_WHATSAPP_PROVIDER=noop
NOTIFICATION_PUSH_PROVIDER=noop
NOTIFICATION_ANNOUNCEMENT_PROVIDER=noop
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=CCD Alerts <alerts@example.com>
