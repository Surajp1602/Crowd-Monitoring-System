# CCD edge: TLS termination, the product site, and the control center (dashboard, API, WebSocket).
# Rendered by the nginx image's envsubst at start: ${APP_HOST}, ${SITE_HOST}.

limit_req_zone $binary_remote_addr zone=auth:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=api:10m rate=30r/s;
limit_req_status 429;

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

upstream ccd_backend  { server backend:8000;  keepalive 32; }
upstream ccd_frontend { server frontend:3000; keepalive 16; }

# Plain HTTP only redirects (and answers ACME challenges if a certbot webroot is mounted).
server {
    listen 80 default_server;
    server_name _;
    location = /healthz { access_log off; return 200 "ok"; }
    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://$host$request_uri; }
}

# Shared TLS and header settings live in the snippet.
server {
    listen 443 ssl default_server;
    http2 on;
    server_name ${APP_HOST};
    include /etc/nginx/snippets/tls.conf;

    client_max_body_size 25m;
    proxy_read_timeout 60s;

    # Prometheus scrapes the backend on the internal network; never expose it.
    location = /metrics { return 404; }

    location = /api/v1/auth/login {
        limit_req zone=auth burst=5 nodelay;
        include /etc/nginx/snippets/proxy.conf;
        proxy_pass http://ccd_backend;
    }

    location /api/ {
        limit_req zone=api burst=60 nodelay;
        include /etc/nginx/snippets/proxy.conf;
        proxy_pass http://ccd_backend;
    }

    location = /health {
        include /etc/nginx/snippets/proxy.conf;
        proxy_pass http://ccd_backend;
    }

    location /ws/ {
        # Not the shared proxy snippet: that clears Connection for keepalive, and a WebSocket needs it.
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
        proxy_pass http://ccd_backend;
    }

    location /_next/static/ {
        include /etc/nginx/snippets/proxy.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        include /etc/nginx/snippets/headers.conf;
        proxy_pass http://ccd_frontend;
    }

    location / {
        include /etc/nginx/snippets/proxy.conf;
        proxy_pass http://ccd_frontend;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${SITE_HOST};
    include /etc/nginx/snippets/tls.conf;

    root /usr/share/nginx/site;
    index index.html;

    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        include /etc/nginx/snippets/headers.conf;
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
