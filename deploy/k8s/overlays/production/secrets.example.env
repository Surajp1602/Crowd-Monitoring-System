# Copy to secrets.prod.env (git-ignored), fill in, then:
#   kubectl -n ccd create secret generic ccd-secrets --from-env-file=secrets.prod.env
DATABASE_URL=postgresql+asyncpg://ccd:<password>@<managed-postgres-host>:5432/ccd
REDIS_URL=rediss://:<password>@<managed-redis-host>:6380/0
SECRET_KEY=
INTERNAL_SERVICE_API_KEY=
CAMERA_CREDENTIAL_ENCRYPTION_KEY=
FIRST_ADMIN_EMAIL=
FIRST_ADMIN_PASSWORD=
METRICS_TOKEN=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=CCD Alerts <alerts@example.com>
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
